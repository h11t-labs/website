---
import Base from '../../layouts/Base.astro';
import WorkItem from '../../components/WorkItem.astro';
import T from '../../components/T.astro';
import { projects } from '../../data/projects';
---

<Base title="Work" description="Projects I built myself, because I needed them. From Python tools to a design system in TypeScript. All of it is open source.">
  <section>
    <p class="kicker">01 <span class="sep">—</span> <span class="on"><T en="projects" nl="projecten" /></span></p>
    <h1 class="page-title"><T en="Projects" nl="Projecten" /></h1>
    <p class="lede">
      <T
        en="Projects I built myself, because I needed them. From Python tools to a design system in TypeScript. All of it is open source."
        nl="Projecten die ik zelf heb gebouwd, omdat ik ze nodig had. Van Python-tools tot een design system in TypeScript. Alles is open source."
      />
    </p>

    <div class="list">
      {projects.map((project, i) => <WorkItem project={project} index={i} />)}
    </div>
  </section>
</Base>

<style>
  .list { margin-top: 2.5rem; }
</style>
